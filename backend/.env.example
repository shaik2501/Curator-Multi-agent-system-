# NOTE: as of the dynamic-credentials system, these provider vars are ONLY
# read once, at first-ever startup, to seed the `llm_configs` table (so a
# working setup here keeps working with zero action). After that first seed,
# /api/llm-configs is the single source of truth — add/edit/remove
# credentials through the running app, not by editing this file later.
ANTHROPIC_API_KEY=sk-ant-...        # seeds a "Claude (from .env)" config if set
TAVILY_API_KEY=tvly-...             # optional; falls back to DuckDuckGo (still read at run time)
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CHEAP_MODEL=claude-haiku-4-5
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI — seeds an "OpenAI (from .env)" config if OPENAI_API_KEY is set
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o                 # sensible default, override freely
OPENAI_CHEAP_MODEL=gpt-4o-mini

# Google Gemini — seeds a "Gemini (from .env)" config if GEMINI_API_KEY is set
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-pro         # sensible default, override freely
GEMINI_CHEAP_MODEL=gemini-2.5-flash

# Custom — any OpenAI-compatible chat-completions endpoint: OpenRouter, Groq,
# Together, Fireworks, LM Studio, vLLM, text-generation-webui, etc. Seeds a
# "Custom (from .env)" config only if BOTH CUSTOM_BASE_URL and CUSTOM_MODEL
# are set. CUSTOM_API_KEY is optional — many local servers don't need one.
CUSTOM_BASE_URL=http://localhost:1234/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_CHEAP_MODEL=                 # optional; falls back to CUSTOM_MODEL if unset

DB_PATH=./data/runs.db
CHROMA_PATH=./data/chroma
MAX_SUPERVISOR_TURNS=12
MAX_DEBATE_ROUNDS=2
